// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Expense {
  id           String   @id @default(cuid())
  title        String
  amount       Float
  category     String?
  occurredAt   DateTime @default(now())
  notes        String?
  receiptPath  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
